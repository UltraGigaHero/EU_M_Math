   "source": [
    "from scipy.optimize import minimize\n",
    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "    return x**2 + 1\n",
    "\n",
    "result = minimize(f, x0 = np.array([0.0]), bounds = [(-1, None)])\n",
    "\n",
    "print(result.x)\n",
    "print(result.fun)"
   ]
  }
