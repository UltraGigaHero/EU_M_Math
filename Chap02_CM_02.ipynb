        "import numpy as np\n",
        "import math\n",
        "\n",
        "n = 10000\n",
        "\n",
        "x = np.random.uniform(-1,1,n)\n",
        "y = np.random.uniform(-1,1,n)\n",
        "\n",
        "incircle = np.hypot(x,y) <= 1\n",
        "% np.hypotは配列を計算できる\n",
        "print(incircle.sum())"
      ]
    }
  ]
